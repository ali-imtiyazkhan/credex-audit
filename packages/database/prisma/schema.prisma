generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Audit {
  id           String   @id @default(cuid())
  publicId     String   @unique @default(cuid())
  tools        Json 
  results      Json     
  totalSaving  Float   
  annualSaving Float    
  teamSize     Int
  useCase      String   
  summary      String? 
  createdAt    DateTime @default(now())

  lead         Lead?
}

model Lead {
  id          String   @id @default(cuid())
  email       String
  companyName String?
  role        String?
  teamSize    Int?
  isHighValue Boolean  @default(false) // true if savings > $500/mo
  auditId     String   @unique
  audit       Audit    @relation(fields: [auditId], references: [id])
  createdAt   DateTime @default(now())
}

model RateLimit {
  id        String   @id @default(cuid())
  ip        String
  endpoint  String
  count     Int      @default(1)
  resetAt   DateTime
  createdAt DateTime @default(now())

  @@unique([ip, endpoint])
}

